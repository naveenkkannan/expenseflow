# Neon Postgres connection (used by the server at runtime)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: used for migrations instead of DATABASE_URL if set
# (e.g. a direct, non-pooled Neon connection string)
DATABASE_URL_DIRECT=

# JWT signing secret for session cookies
JWT_SECRET=change-me-to-a-long-random-string

# The only user account, created by `npm run seed:user`
SEED_EMAIL=you@example.com
SEED_PASSWORD=change-me

# Server port
PORT=4000

# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
